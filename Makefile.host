# Makefile.host — компиляция под x86 для тестов
CC_HOST = gcc
CFLAGS_HOST = -Wall -Wextra -g -O0 -DHOST_BUILD -fsanitize=address

SRCS_HOST = tests/test_pid.c pid.c modes.c rd_filter_pred_fixed.c hal_stub.c

test: $(SRCS_HOST)
	$(CC_HOST) $(CFLAGS_HOST) -o run_tests $^ -lm
	./run_tests

clean:
	rm -f run_tests